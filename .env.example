# =====================================================================
# MittenLink — environment configuration
# Copy to .env.local for local development. NEVER commit real secrets.
# Every integration has a safe default so the demo runs with no accounts.
# =====================================================================

# ---------------------------------------------------------------------
# General
# ---------------------------------------------------------------------
# Public base URL used in emails and Stripe return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shows the "Demonstration Data" banner and enables one-click demo sign-in
# and dev-only helper routes (dev helpers also require NODE_ENV=development).
# Set to false for a real launch.
DEMO_MODE=true

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
# pglite  = embedded PostgreSQL (WASM) stored in ./.data/pglite — zero setup.
# postgres = any PostgreSQL 15+ with PostGIS (Supabase recommended).
# If unset: postgres when DATABASE_URL is set, otherwise pglite.
DB_DRIVER=pglite
# Local PGlite data directory (optional).
# PGLITE_DATA_DIR=./.data/pglite
# Seed demo data automatically when the local database is empty.
DEMO_AUTO_SEED=true

# Supabase / PostgreSQL connection (server-side only).
# Use the Supabase *transaction pooler* URL on serverless hosts (port 6543).
# The role must be able to `SET ROLE anon|authenticated` (Supabase `postgres` role can).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-2.pooler.supabase.com:6543/postgres
# DATABASE_POOL_MAX=5
# Apply pending migrations on server start (normally use `supabase db push` instead).
# DB_AUTO_MIGRATE=false
# For plain PostgreSQL (not Supabase), also apply db/local/000_supabase_compat.sql:
# DB_INCLUDE_COMPAT=false

# ---------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------
# local    = bcrypt passwords stored in auth.users + signed HttpOnly cookie
# supabase = Supabase Auth (email/password) via @supabase/ssr
AUTH_PROVIDER=local
# Required for AUTH_PROVIDER=local. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-characters

# Password assigned to seeded demonstration accounts (admin@mittenlink.demo, etc.).
# Choose your own value; it is never shown in the UI.
DEMO_ACCOUNT_PASSWORD=choose-a-demo-password

# Supabase project (required for AUTH_PROVIDER=supabase or STORAGE_PROVIDER=supabase)
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the seed script (to create Auth users) and storage adapter.
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Payments — Stripe TEST MODE only for the demo
# ---------------------------------------------------------------------
# Without keys a clearly labeled demo billing adapter is used (no card, no charge).
# Live keys (sk_live_…) are refused while DEMO_MODE=true.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ---------------------------------------------------------------------
# Email notifications
# ---------------------------------------------------------------------
# log    = write to server log only (default)
# resend = send with Resend
EMAIL_PROVIDER=log
# RESEND_API_KEY=
# EMAIL_FROM="MittenLink <notifications@your-domain.org>"

# ---------------------------------------------------------------------
# Maps (the list view never depends on the map)
# ---------------------------------------------------------------------
# leaflet-osm (default, OpenStreetMap tiles) | mapbox | none
NEXT_PUBLIC_MAP_PROVIDER=leaflet-osm
# NEXT_PUBLIC_MAPBOX_TOKEN=

# ---------------------------------------------------------------------
# AI-assisted discovery (optional). Without a key, a deterministic
# rules-based assistant is used and labeled as such.
# ---------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------
# File storage (Enhanced listing logos)
# ---------------------------------------------------------------------
# local    = ./.data/uploads (development)
# supabase = Supabase Storage bucket
STORAGE_PROVIDER=local
# SUPABASE_STORAGE_BUCKET=listing-media

# ---------------------------------------------------------------------
# Development
# ---------------------------------------------------------------------
# Opt in to Turbopack's on-disk dev cache (disabled by default; see README).
# TURBOPACK_FS_CACHE=false
